# =====================================================
# Modern Web Optimization Project
# Build artifacts & generated files (untracked, safe to delete)
# =====================================================

# Emscripten/WebAssembly compiler output - always excluded from git
views/js/pizza.js views/js/pizza.wasm

# Native build artifacts (won't work without emscripten.h headers on macOS)
pizza_native server_native 

# Pre-compiled binary object files - only include src/*.o if not in Makefile pattern
src/*.o

# =====================================================
# Generated by tools/build systems - exclude these
# =====================================================
*.log
.cache/
.output/

# ==============================================
# OS & System Files (macOS/Linux)
# ===============================================
.DS_Store          # macOS hidden file marker .gitignore
Thumbs.db         # Windows thumbnail cache
*.swp             # Emacs swap files
*~                # Backup/temporary files

# =====================================================
# Version Control (Git)
# =====================================================
.git/

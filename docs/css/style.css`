:root {
    --primary: #ff4d4d;
    --primary-hover: #ff1a1a;
    --bg-dark: #0f172a;
    --bg-card: rgba(30, 41, 59, 0.7);
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --accent: #fbbf24;
    --glass-border: rgba(255, 255, 255, 0.1);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-dark);
    color: var(--text-main);
    overflow-x: hidden;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
}

.background-parallax {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    background: radial-gradient(circle at center, #1e293b 0%, #0f172a 100%);
    opacity: 0.8;
}

.container {
    width: 100%;
    max-width: 800px;
    padding: 2rem;
    text-align: center;
}

.hero {
    margin-bottom: 3rem;
}

.title {
    font-family: 'Pacifico', cursive;
    font-size: 4rem;
    margin-bottom: 0.5rem;
}

.highlight {
    color: var(--primary);
}

.subtitle {
    font-size: 1.2rem;
    color: var(--text-muted);
}

.wasm-badge {
    background: linear-gradient(45deg, #6366f1, #a855f7);
    color: white;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: bold;
}

.generator-card {
    background: var(--bg-card);
    backdrop-filter: blur(12px);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    padding: 3rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    transition: transform 0.3s ease;
}

.generator-card:hover {
    transform: translateY(-5px);
}

.card-header h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
}

.card-header p {
    color: var(--text-muted);
    margin-bottom: 2rem;
}

.result-area {
    margin-bottom: 2rem;
    padding: 2rem;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 16px;
    border: 1px dashed var(--glass-border);
}

.pizza-name {
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--accent);
    margin-bottom: 1rem;
    min-height: 3rem;
}

.pizza-ingredients {
    font-size: 1.1rem;
    color: var(--text-main);
    line-height: 1.6;
    font-style: italic;
}

.btn-primary {
    background-color: var(--primary);
    color: white;
    border: none;
    padding: 1rem 2.5rem;
    font-size: 1.2rem;
    font-weight: bold;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 10px 15px -3px rgba(255, 77, 77, 0.4);
}

.btn-primary:hover {
    background-color: var(--primary-hover);
    transform: scale(1.05);
    box-shadow: 0 20px 25px -5px rgba(255, 77, 77, 0.5);
}

.info-footer {
    margin-top: 3rem;
    color: var(--text-muted);
}

.stats-grid {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-top: 1rem;
    font-size: 0.9rem;
}

.stat-item {
    background: rgba(255, 255, 255, 0.05);
    padding: 0.5rem 1rem;
    border-radius: 8px;
}
